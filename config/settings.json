{
  "service": {
    "host": "127.0.0.1",
    "port": 8020,
    "log_level": "info",
    "grpc": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 8021,
      "max_receive_message_bytes": 16777216,
      "max_send_message_bytes": 16777216,
      "stream_buffer_chunks": 4,
      "stream_buffer_bytes": 1048576,
      "stalled_consumer_timeout_s": 2.0,
      "shutdown_grace_s": 5.0
    }
  },
  "engine": {
    "backend": "nanovllm_voxcpm",
    "fairness": {
      "default_weight": 1.0,
      "weights": {},
      "soft_max_inflight_per_key": 1,
      "max_pending_per_key": 4,
      "max_pending_per_executor": 8,
      "idle_state_ttl_s": 300
    },
    "models": {
      "stub-tts": {
        "backend": "stub",
        "enabled": false,
        "target_inflight": 1
      },
      "kokoro": {
        "backend": "kokoro",
        "model_path": "/home/gunnar/models/kokoro",
        "enabled": true,
        "target_inflight": 1,
        "kokoro_speed": 1.0,
        "kokoro_warmup_enabled": true,
        "kokoro_warmup_languages": ["English", "British English"],
        "voice_presets": {
          "English": "af_heart",
          "British English": "bf_emma",
          "French": "ff_siwis",
          "Spanish": "ef_dora",
          "Italian": "if_sara",
          "Portuguese": "pf_dora",
          "Brazilian Portuguese": "pf_dora",
          "Hindi": "hf_alpha",
          "Japanese": "jf_alpha",
          "Chinese": "zf_xiaobei"
        }
      },
      "voxcpm2": {
        "backend": "voxcpm2",
        "enabled": false,
        "target_inflight": 1,
        "voxcpm2_model_id": "openbmb/VoxCPM2",
        "voxcpm2_load_denoiser": false,
        "voxcpm2_optimize": true,
        "voxcpm2_cfg_value": 2.0,
        "voxcpm2_inference_timesteps": 10,
        "voxcpm2_normalize": false,
        "voxcpm2_denoise": false,
        "voxcpm2_reference_max_duration_s": 8.0,
        "voxcpm2_warmup_enabled": true
      },
      "nanovllm_voxcpm": {
        "backend": "nanovllm_voxcpm",
        "enabled": true,
        "target_inflight": 4,
        "nanovllm_model_id": "openbmb/VoxCPM2",
        "nanovllm_devices": [0],
        "nanovllm_max_num_seqs": 4,
        "nanovllm_max_num_batched_tokens": 4096,
        "nanovllm_max_model_len": 2048,
        "nanovllm_gpu_memory_utilization": 0.85,
        "nanovllm_inference_timesteps": 10,
        "nanovllm_max_generate_length": 256,
        "nanovllm_temperature": 1.0,
        "nanovllm_cfg_value": 2.0,
        "nanovllm_reference_max_duration_s": 8.0,
        "nanovllm_warmup_enabled": false,
        "nanovllm_warmup_cases": []
      }
    }
  }
}
